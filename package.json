{
  "name": "aegis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/claims",
    "apps/public"
  ],
  "scripts": {
    "dev:claims": "npm run dev -w apps/claims",
    "dev:web": "npm run dev -w apps/web",
    "dev:public": "npm run dev -w apps/public",
    "build": "npm run build -w apps/claims && npm run build -w apps/web && npm run build -w apps/public",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/public"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
